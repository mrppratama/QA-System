generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  projectUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCaseSets      TestCaseSet[]
  automationScripts AutomationScript[]
  pages             Page[]
}

model TestCaseSet {
  id             String   @id @default(cuid())
  projectId      String?
  feature        String
  description    String?
  userFlow       String?
  expectedResult String?
  role           String?
  testedBy       String?
  count          Int      @default(20)
  createdAt      DateTime @default(now())

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  testCases TestCase[]

  @@index([projectId])
}

model TestCase {
  id               String   @id @default(cuid())
  testCaseSetId    String
  testCaseId       String
  featureModule    String
  testScenario     String
  type             String
  precondition     String?
  actionStep       String
  testData         String?
  expectedResult   String
  actualResult     String?
  testingResult    String   @default("Not Tested")
  testDate         String?
  testBy           String?
  bugNote          String?
  automationStatus String   @default("Not Automated")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  testCaseSet TestCaseSet @relation(fields: [testCaseSetId], references: [id], onDelete: Cascade)

  @@index([testCaseSetId])
}

model AutomationScript {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  description      String?
  script           String
  status           String   @default("Generated")
  tool             String?
  generationSource String   @default("ai")
  testCaseIds      String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Page {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  path          String    @default("/")
  description   String?
  requiresAuth  Boolean   @default(false)
  // Elements found by the (not-yet-configured) scanner, as a JSON array of
  // {selector, tag, text, role} — "[]" until a scan has actually run.
  elements      String    @default("[]")
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ExcelFile {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  path         String
  sheets       String
  createdAt    DateTime @default(now())
}
