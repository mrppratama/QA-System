# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL)
# DATABASE_URL: Transaction Connection Pooler URL (port 6543)
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct PostgreSQL Connection URL (port 5432) for Prisma migrations
DIRECT_URL="postgres://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# AI Provider
AI_PROVIDER=nine-router

# 9Router Configuration
NINE_ROUTER_BASE_URL=https://9router.bigmoveintelligent.com/v1
NINE_ROUTER_API_KEY=your_api_key_here
NINE_ROUTER_MODEL=cc/claude-sonnet-4-6
NINE_ROUTER_TIMEOUT=60000
